[app-grid-tuner]
app-hover-tile-enabled=true
appgrid-max-columns=12
appgrid-max-rows=5
label-style=''
reload-signal=false
side-padding=0

[arcmenu]
recently-installed-apps=['Counter-Strike 2.desktop', 'Cult of the Lamb.desktop', 'Down in Bermuda.desktop', 'Storyteller.desktop', 'Cuphead.desktop', 'NOT A HERO.desktop', 'Serial Cleaner.desktop', 'Just Die Already.desktop', 'Metal Slug Awakening.desktop', 'Papers, Please.desktop', 'Streets of Rage 4.desktop', 'lstopo.desktop', 'com.mattjakeman.ExtensionManager.desktop', 'org.kde.digikam.desktop', 'mysql-workbench.desktop', 'net.damonlynch.rapid_photo_downloader.desktop', 'nvim.desktop', 'org.gnome.Evolution.desktop', 'org.kde.showfoto.desktop', 'org.darktable.darktable.desktop', 'gmic_qt.desktop', 'sqlitebrowser.desktop', 'Bloons TD 6.desktop', 'vlc.desktop', 'cmake-gui.desktop', 'steam.desktop', 'virtualbox.desktop', 'Resident Evil 6 Benchmark Tool.desktop', 'timeshift-gtk.desktop', 'Game Character Hub.desktop', 'code.desktop', 'antigravity.desktop', 'heroic.desktop', 'google-chrome.desktop', 'brave-browser.desktop', 'com.google.Chrome.desktop', 'org.vinegarhq.Vinegar.desktop', 'ezame.desktop', 'chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default.desktop', 'btop.desktop', 'com.github.wwmm.easyeffects.desktop']
update-notifier-project-version=71

[blur-my-shell]
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
brightness=0.59999999999999998
pipeline='pipeline_default'
sigma=30

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=false
indicator-position-max=1
user-enabled=true

[dash-to-dock]
apply-custom-theme=true
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=48
dock-position='BOTTOM'
height-fraction=0.90000000000000002
icon-size-fixed=false
preferred-monitor=-2
preferred-monitor-by-connector='HDMI-1'
preview-size-scale=0.45000000000000001
show-mounts-network=true

[gamemode-screen]
auto-switch=false

[gamemodeshellextension]
show-icon-only-when-active=true

[just-perfection]
support-notifier-showed-version=36

[rounded-window-corners-reborn]
settings-version=uint32 8

[tiling-assistant]
activate-layout0=@as []
activate-layout1=@as []
activate-layout2=@as []
activate-layout3=@as []
auto-tile=@as []
center-window=@as []
debugging-free-rects=@as []
debugging-show-tiled-rects=@as []
default-move-mode=0
dynamic-keybinding-behavior=0
focus-hint=0
focus-hint-color='rgb(53,132,228)'
import-layout-examples=false
last-version-installed=54
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.desktop.wm.keybindings.maximize': <@mb nothing>, 'org.gnome.desktop.wm.keybindings.unmaximize': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
restore-window=['<Super>Down']
search-popup-layout=@as []
tile-bottom-half=['<Super>KP_2']
tile-bottom-half-ignore-ta=@as []
tile-bottomleft-quarter=['<Super>KP_1']
tile-bottomleft-quarter-ignore-ta=@as []
tile-bottomright-quarter=['<Super>KP_3']
tile-bottomright-quarter-ignore-ta=@as []
tile-edit-mode=@as []
tile-left-half=['<Super>Left', '<Super>KP_4']
tile-left-half-ignore-ta=@as []
tile-maximize=['<Super>Up', '<Super>KP_5']
tile-maximize-horizontally=@as []
tile-maximize-vertically=@as []
tile-right-half=['<Super>Right', '<Super>KP_6']
tile-right-half-ignore-ta=@as []
tile-top-half=['<Super>KP_8']
tile-top-half-ignore-ta=@as []
tile-topleft-quarter=['<Super>KP_7']
tile-topleft-quarter-ignore-ta=@as []
tile-topright-quarter=['<Super>KP_9']
tile-topright-quarter-ignore-ta=@as []
toggle-always-on-top=@as []
toggle-tiling-popup=@as []

[wiggly]
hide-cursor=true
